# NeuraForge Backend Environment Variables
# Copy this file to .env and fill in real values

# Required: Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Increases GitHub API rate limit from 60 to 5000 req/hour
# Get at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here
